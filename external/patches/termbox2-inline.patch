+/* Ask the terminal for the cursor row (DSR/CPR). Returns 0 and sets *row (1-based)
+ * on success, -1 otherwise -- including on timeout, which is the point: the read
+ * is bounded, so an unresponsive terminal costs a few milliseconds and a less
+ * pretty placement instead of hanging. termbox2 already uses this exact pattern in
+ * update_term_size_via_esc(). */
+static int inline_query_cursor_row(int *row) {
+#ifndef TB_INLINE_CURSOR_MS
+#define TB_INLINE_CURSOR_MS 150
+#endif
+    fd_set fds;
+    struct timeval timeout;
+    char buf[TB_OPT_READ_BUF];
+    ssize_t read_rv;
+    int r, c;
+
+    if (global.rfd < 0 || global.wfd < 0) return -1;
+    /* Anything already queued must go out first, or the query would overtake it. */
+    bytebuf_flush(&global.out, global.wfd);
+    if (write(global.wfd, "\x1b[6n", 4) != 4) return -1;
+
+    FD_ZERO(&fds);
+    FD_SET(global.rfd, &fds);
+    timeout.tv_sec = 0;
+    timeout.tv_usec = TB_INLINE_CURSOR_MS * 1000;
+    if (select(global.rfd + 1, &fds, NULL, NULL, &timeout) != 1) return -1;
+
+    read_rv = read(global.rfd, buf, sizeof(buf) - 1);
+    if (read_rv < 1) return -1;
+    buf[read_rv] = '\0';
+    if (sscanf(buf, "\x1b[%d;%dR", &r, &c) != 2) return -1;
+    *row = r;
+    return 0;
+}
+
+/* Anchor the viewport at the cursor -- i.e. directly under the shell prompt that
+ * launched us, which is what makes this feel like fzf --height rather than a panel
+ * stranded at the bottom of the screen. */
+static int inline_place_viewport(void) {
+    int rv, i, cursor_row = 0, origin, scroll;
+    char nbuf[32];
+
+    if (global.inline_height <= 0) return TB_OK;
+
+    if (inline_query_cursor_row(&cursor_row) == 0 && cursor_row >= 1) {
+        origin = cursor_row - 1;
+    } else {
+        origin = global.term_h - global.height; /* no answer: use the bottom */
+    }
+    if (origin < 0) origin = 0;
+
+    scroll = origin + global.height - global.term_h;
+    if (scroll > 0) {
+        /* Not enough room below the cursor. Scroll from the last row so every
+         * newline moves the screen up exactly one line -- deterministic, unlike
+         * emitting newlines from wherever the cursor happens to be -- and follow
+         * the anchor up as the content moves. */
+        send_literal(rv, "\x1b[");
+        send_num(rv, nbuf, global.term_h);
+        send_literal(rv, ";1H");
+        for (i = 0; i < scroll; i++) {
+            if_err_return(rv, bytebuf_puts(&global.out, "\n"));
+        }
+        origin -= scroll;
+        if (origin < 0) origin = 0;
+    }
+
+    global.origin_y = origin;
+    global.prev_origin_y = origin;
+    global.inline_placed = 1;
+    if_err_return(rv, bytebuf_flush(&global.out, global.wfd));
+    global.last_x = -1;
+    global.last_y = -1;
+    return TB_OK;
+}
+
+/* Blank `count` terminal rows starting at absolute row `first`, leaving the cursor
+ * at its top-left. Absolute, not viewport-relative, because a resize has to clean
+ * up rows the viewport has just vacated. */
+static int inline_erase_abs_rows(int first, int count) {
+    int rv, i;
+    char nbuf[32];
+    if (count <= 0) return TB_OK;
+    if (first < 0) first = 0;
+    if_err_return(rv, bytebuf_puts(&global.out, global.caps[TB_CAP_SGR0]));
+    for (i = 0; i < count; i++) {
+        send_literal(rv, "\x1b[");
+        send_num(rv, nbuf, first + i + 1);
+        send_literal(rv, ";1H");
+        if_err_return(rv, bytebuf_puts(&global.out, TB_HARDCAP_ERASE_LINE));
+    }
+    send_literal(rv, "\x1b[");
+    send_num(rv, nbuf, first + 1);
+    send_literal(rv, ";1H");
+    global.last_x = -1;
+    global.last_y = -1;
+    return TB_OK;
+}
+
+static int inline_erase_viewport(void) {
+    if (global.inline_height <= 0 || global.height <= 0) return TB_OK;
+    return inline_erase_abs_rows(global.origin_y, global.height);
+}
