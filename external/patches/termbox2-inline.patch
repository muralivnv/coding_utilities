+static void inline_clamp_geometry(void) {
+    /* update_term_size() has just stored the *terminal* geometry. Translate it
+     * once, here, so the rest of the library can go on treating global.height as
+     * "the height we draw into" and stay oblivious to inline mode. */
+    int rows;
+    if (global.inline_height <= 0) return;
+    rows = global.height;
+    if (rows <= 0) return;
+    global.term_h = rows;
+    global.prev_origin_y = global.origin_y;
+    global.height = global.inline_height < rows ? global.inline_height : rows;
+    if (!global.inline_placed) {
+        /* inline_place_viewport() establishes the anchor during init. */
+        global.origin_y = 0;
+        return;
+    }
+    /* On resize keep the anchor where it is, only pushing it up far enough that
+     * the viewport still fits. */
+    if (global.origin_y + global.height > rows) {
+        global.origin_y = rows - global.height;
+        if (global.origin_y < 0) global.origin_y = 0;
+    }
+}
