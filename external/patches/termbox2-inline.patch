+        send_literal(rv, ";1H");
+        if_err_return(rv, bytebuf_puts(&global.out, TB_HARDCAP_ERASE_LINE));
+    }
+    send_literal(rv, "\x1b[");
+    send_num(rv, nbuf, first + 1);
+    send_literal(rv, ";1H");
+    global.last_x = -1;
+    global.last_y = -1;
+    return TB_OK;
+}
+
+static int inline_erase_viewport(void) {
+    if (global.inline_height <= 0 || global.height <= 0) return TB_OK;
+    return inline_erase_abs_rows(global.origin_y, global.height);
