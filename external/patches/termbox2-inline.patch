+    global.origin_y = origin;
+    global.prev_origin_y = origin;
+    global.inline_placed = 1;
+    if_err_return(rv, bytebuf_flush(&global.out, global.wfd));
+    global.last_x = -1;
+    global.last_y = -1;
+    return TB_OK;
