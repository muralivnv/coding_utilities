+/* Anchor the viewport at the cursor -- i.e. directly under the shell prompt that
+ * launched us, which is what makes this feel like fzf --height rather than a panel
+ * stranded at the bottom of the screen. */
+static int inline_place_viewport(void) {
+    int rv, i, cursor_row = 0, origin, scroll;
+    char nbuf[32];
+
+    if (global.inline_height <= 0) return TB_OK;
+
+    if (inline_query_cursor_row(&cursor_row) == 0 && cursor_row >= 1) {
+        origin = cursor_row - 1;
+    } else {
+        origin = global.term_h - global.height; /* no answer: use the bottom */
+    }
+    if (origin < 0) origin = 0;
+
+    scroll = origin + global.height - global.term_h;
+    if (scroll > 0) {
+        /* Not enough room below the cursor. Scroll from the last row so every
+         * newline moves the screen up exactly one line -- deterministic, unlike
+         * emitting newlines from wherever the cursor happens to be -- and follow
+         * the anchor up as the content moves. */
+        send_literal(rv, "\x1b[");
+        send_num(rv, nbuf, global.term_h);
+        send_literal(rv, ";1H");
+        for (i = 0; i < scroll; i++) {
+            if_err_return(rv, bytebuf_puts(&global.out, "\n"));
+        }
+        origin -= scroll;
+        if (origin < 0) origin = 0;
+    }
